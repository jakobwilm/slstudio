include_guard(GLOBAL)

function(slstudio_feature name description)
    set(${name} AUTO CACHE STRING "${description} (AUTO, ON or OFF)")
    string(TOUPPER "${${name}}" mode)
    if(NOT mode MATCHES "^(AUTO|ON|OFF)$")
        message(FATAL_ERROR "${name} must be AUTO, ON or OFF (got '${${name}}')")
    endif()
    # Preserve existing choices while migrating BOOL cache entries to three-state strings.
    set(${name} "${mode}" CACHE STRING "${description} (AUTO, ON or OFF)" FORCE)
    set_property(CACHE ${name} PROPERTY STRINGS AUTO ON OFF)
    set(${name} "${mode}" PARENT_SCOPE)
endfunction()

function(slstudio_resolve_feature name available requirements)
    if(${name} STREQUAL "ON" AND NOT available)
        message(FATAL_ERROR "${name}=ON requires ${requirements}")
    endif()
    string(REGEX REPLACE "^SLSTUDIO_" "" label "${name}")
    if(${name} STREQUAL "OFF")
        set(enabled OFF)
        set(status "disabled (requested OFF)")
    elseif(available)
        set(enabled ON)
        set(status enabled)
    else()
        set(enabled OFF)
        set(status "disabled (requires ${requirements})")
    endif()
    set(${name}_ENABLED "${enabled}" CACHE INTERNAL "Resolved support for ${name}" FORCE)
    set_property(GLOBAL APPEND PROPERTY SLSTUDIO_FEATURE_SUMMARY "${label}: ${status}")
endfunction()

function(slstudio_feature_summary)
    message(STATUS "Optional integrations:")
    get_property(summary GLOBAL PROPERTY SLSTUDIO_FEATURE_SUMMARY)
    foreach(entry IN LISTS summary)
        message(STATUS "  ${entry}")
    endforeach()
endfunction()
