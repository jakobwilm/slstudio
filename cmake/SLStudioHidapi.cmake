include_guard(GLOBAL)

set(SLSTUDIO_HIDAPI_AVAILABLE OFF)
if(WIN32)
    set(SLSTUDIO_HIDAPI_BACKEND winapi)
elseif(APPLE)
    set(SLSTUDIO_HIDAPI_BACKEND darwin)
elseif(CMAKE_SYSTEM_NAME STREQUAL "Linux")
    set(SLSTUDIO_HIDAPI_BACKEND hidraw)
else()
    return()
endif()

find_package(hidapi 0.14 CONFIG QUIET)
if(TARGET hidapi::${SLSTUDIO_HIDAPI_BACKEND})
    set(SLSTUDIO_HIDAPI_TARGET hidapi::${SLSTUDIO_HIDAPI_BACKEND})
elseif((WIN32 OR APPLE) AND TARGET hidapi::hidapi)
    set(SLSTUDIO_HIDAPI_TARGET hidapi::hidapi)
else()
    find_package(PkgConfig QUIET)
    set(_slstudio_pkg_config_args "${PKG_CONFIG_ARGN}")
    list(APPEND PKG_CONFIG_ARGN --static)
    if(PkgConfig_FOUND AND CMAKE_SYSTEM_NAME STREQUAL "Linux")
        pkg_check_modules(SLSTUDIO_HIDAPI_NATIVE QUIET IMPORTED_TARGET hidapi-hidraw>=0.14)
    elseif(PkgConfig_FOUND AND APPLE)
        pkg_check_modules(SLSTUDIO_HIDAPI_NATIVE QUIET IMPORTED_TARGET hidapi>=0.14)
    endif()
    set(PKG_CONFIG_ARGN "${_slstudio_pkg_config_args}")
    if(TARGET PkgConfig::SLSTUDIO_HIDAPI_NATIVE)
        if(CMAKE_SYSTEM_NAME STREQUAL "Linux" AND "${SLSTUDIO_HIDAPI_NATIVE_LINK_LIBRARIES}" MATCHES "\\.a(;|$)")
            find_package(Threads REQUIRED)
            pkg_check_modules(SLSTUDIO_HIDAPI_UDEV QUIET IMPORTED_TARGET libudev)
            if(TARGET PkgConfig::SLSTUDIO_HIDAPI_UDEV)
                set(SLSTUDIO_HIDAPI_TARGET PkgConfig::SLSTUDIO_HIDAPI_NATIVE)
                target_link_libraries(PkgConfig::SLSTUDIO_HIDAPI_NATIVE INTERFACE PkgConfig::SLSTUDIO_HIDAPI_UDEV Threads::Threads)
            endif()
        else()
            set(SLSTUDIO_HIDAPI_TARGET PkgConfig::SLSTUDIO_HIDAPI_NATIVE)
        endif()
    endif()
endif()

if(SLSTUDIO_HIDAPI_TARGET OR WIN32 OR APPLE)
    set(SLSTUDIO_HIDAPI_AVAILABLE ON)
elseif(PkgConfig_FOUND)
    pkg_check_modules(SLSTUDIO_HIDAPI_UDEV QUIET libudev)
    set(SLSTUDIO_HIDAPI_AVAILABLE "${SLSTUDIO_HIDAPI_UDEV_FOUND}")
endif()

function(slstudio_require_hidapi)
    if(SLSTUDIO_HIDAPI_TARGET)
        message(STATUS "LC4500: using installed ${SLSTUDIO_HIDAPI_TARGET}")
        return()
    endif()
    if(NOT SLSTUDIO_HIDAPI_AVAILABLE)
        message(FATAL_ERROR "LC4500 requires native HIDAPI. On Linux install pkg-config and libudev development headers, or an installed HIDAPI >= 0.14 hidraw package.")
    endif()
    include(FetchContent)
    if(POLICY CMP0135)
        cmake_policy(SET CMP0135 NEW)
    endif()
    set(BUILD_SHARED_LIBS OFF)
    set(HIDAPI_WITH_HIDRAW ON)
    set(HIDAPI_WITH_LIBUSB OFF)
    set(HIDAPI_INSTALL_TARGETS OFF)
    set(HIDAPI_WITH_TESTS OFF)
    set(HIDAPI_BUILD_HIDTEST OFF)
    set(HIDAPI_BUILD_PP_DATA_DUMP OFF)
    FetchContent_Declare(hidapi
        URL https://codeload.github.com/libusb/hidapi/tar.gz/refs/tags/hidapi-0.15.0
        URL_HASH SHA256=5d84dec684c27b97b921d2f3b73218cb773cf4ea915caee317ac8fc73cef8136)
    FetchContent_MakeAvailable(hidapi)
    set(SLSTUDIO_HIDAPI_TARGET hidapi::${SLSTUDIO_HIDAPI_BACKEND} PARENT_SCOPE)
    message(STATUS "LC4500: building HIDAPI 0.15.0 (${SLSTUDIO_HIDAPI_BACKEND}, static)")
    set(license_destination "${CMAKE_INSTALL_DATADIR}/licenses/SLStudio")
    if(APPLE)
        set(license_destination "SLStudio.app/Contents/Resources/licenses")
    endif()
    install(FILES "${hidapi_SOURCE_DIR}/LICENSE-bsd.txt" "${hidapi_SOURCE_DIR}/AUTHORS.txt"
        DESTINATION "${license_destination}/hidapi" COMPONENT Runtime)
endfunction()
