cmake_minimum_required(VERSION 3.21)

set(version 0.8.36)
set(sha256 246deaa0042a387ff1bc00332d0fb80537ce14abde2c28d1a54c91f17adc51bf)
get_filename_component(project_dir "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
if(NOT DEFINED ARAVIS_WORK_DIR)
    set(ARAVIS_WORK_DIR "${project_dir}/build/dependencies/aravis-${version}")
endif()
if(NOT DEFINED ARAVIS_PREFIX)
    set(ARAVIS_PREFIX "${project_dir}/build/dependencies/install")
endif()
get_filename_component(ARAVIS_WORK_DIR "${ARAVIS_WORK_DIR}" ABSOLUTE)
get_filename_component(ARAVIS_PREFIX "${ARAVIS_PREFIX}" ABSOLUTE)
find_program(MESON_EXECUTABLE meson REQUIRED)
find_program(NINJA_EXECUTABLE ninja REQUIRED)

if(CMAKE_HOST_WIN32)
    set(path_separator ";")
    if(NOT DEFINED ARAVIS_VCPKG_ROOT)
        if(DEFINED ENV{VCPKG_ROOT})
            set(ARAVIS_VCPKG_ROOT "$ENV{VCPKG_ROOT}")
        else()
            set(ARAVIS_VCPKG_ROOT "${project_dir}/.vcpkg")
        endif()
    endif()
    if(NOT DEFINED ARAVIS_VCPKG_TRIPLET)
        set(ARAVIS_VCPKG_TRIPLET x64-windows)
    endif()
    if(NOT ARAVIS_VCPKG_TRIPLET MATCHES "-windows$")
        message(FATAL_ERROR "Use a shared MSVC vcpkg triplet, such as x64-windows")
    endif()
    get_filename_component(ARAVIS_VCPKG_ROOT "${ARAVIS_VCPKG_ROOT}" ABSOLUTE)
    set(vcpkg_prefix "${ARAVIS_VCPKG_ROOT}/installed/${ARAVIS_VCPKG_TRIPLET}")
    find_program(PKG_CONFIG_EXECUTABLE NAMES pkgconf.exe pkg-config.exe
        PATHS "${vcpkg_prefix}/tools/pkgconf" "${vcpkg_prefix}/tools/pkg-config"
        NO_DEFAULT_PATH REQUIRED)
    set(ENV{PKG_CONFIG} "${PKG_CONFIG_EXECUTABLE}")
    set(ENV{PKG_CONFIG_LIBDIR} "${vcpkg_prefix}/lib/pkgconfig;${vcpkg_prefix}/share/pkgconfig")
    set(ENV{PATH} "${vcpkg_prefix}/bin;$ENV{PATH}")
    list(PREPEND ARAVIS_DEPENDENCY_PREFIXES "${vcpkg_prefix}")
    set(platform_options --vsenv -Db_vscrt=md)
else()
    set(path_separator ":")
endif()
set(pkg_config_paths)
foreach(prefix IN LISTS ARAVIS_DEPENDENCY_PREFIXES)
    get_filename_component(prefix "${prefix}" ABSOLUTE)
    list(APPEND pkg_config_paths "${prefix}/lib/pkgconfig" "${prefix}/share/pkgconfig")
endforeach()
if(pkg_config_paths)
    list(JOIN pkg_config_paths "${path_separator}" pkg_config_path)
    if(NOT "$ENV{PKG_CONFIG_PATH}" STREQUAL "")
        string(APPEND pkg_config_path "${path_separator}$ENV{PKG_CONFIG_PATH}")
    endif()
    set(ENV{PKG_CONFIG_PATH} "${pkg_config_path}")
endif()

function(run)
    execute_process(COMMAND ${ARGV} COMMAND_ECHO STDOUT RESULT_VARIABLE result)
    if(NOT "${result}" STREQUAL "0")
        message(FATAL_ERROR "Aravis dependency build failed: ${result}")
    endif()
endfunction()

file(MAKE_DIRECTORY "${ARAVIS_WORK_DIR}")
set(archive "${ARAVIS_WORK_DIR}/aravis-${version}.tar.xz")
if(EXISTS "${archive}")
    file(SHA256 "${archive}" actual_sha256)
    if(NOT actual_sha256 STREQUAL sha256)
        message(FATAL_ERROR "Aravis archive checksum mismatch. Remove ${archive} and retry.")
    endif()
else()
    file(DOWNLOAD
        "https://github.com/AravisProject/aravis/releases/download/${version}/aravis-${version}.tar.xz"
        "${archive}" EXPECTED_HASH "SHA256=${sha256}" TLS_VERIFY ON
        TIMEOUT 120 INACTIVITY_TIMEOUT 30 SHOW_PROGRESS)
endif()

set(source_dir "${ARAVIS_WORK_DIR}/aravis-${version}")
set(build_dir "${ARAVIS_WORK_DIR}/build")
if(NOT EXISTS "${source_dir}/meson.build")
    file(ARCHIVE_EXTRACT INPUT "${archive}" DESTINATION "${ARAVIS_WORK_DIR}")
endif()
if(EXISTS "${build_dir}/meson-private/coredata.dat")
    set(reconfigure --reconfigure)
endif()
run("${MESON_EXECUTABLE}" setup ${reconfigure} "${build_dir}" "${source_dir}"
    "--prefix=${ARAVIS_PREFIX}" --libdir=lib --buildtype=release --backend=ninja ${platform_options}
    --default-library=shared --wrap-mode=nofallback
    -Dusb=enabled -Dviewer=disabled -Dgst-plugin=disabled
    -Dintrospection=disabled -Ddocumentation=disabled -Dtests=false)
run("${MESON_EXECUTABLE}" compile -C "${build_dir}")
run("${MESON_EXECUTABLE}" install -C "${build_dir}")

set(source_install "${ARAVIS_PREFIX}/share/slstudio/aravis-${version}")
file(INSTALL "${archive}" DESTINATION "${source_install}")
file(GLOB licenses "${source_dir}/COPYING*")
file(INSTALL ${licenses} DESTINATION "${source_install}")
if(CMAKE_HOST_WIN32)
    set(runtime "${ARAVIS_PREFIX}/bin/aravis-0.8-0.dll")
    if(NOT EXISTS "${ARAVIS_PREFIX}/lib/aravis-0.8.lib")
        message(FATAL_ERROR "Aravis MSVC import library is missing")
    endif()
    set(ENV{PATH} "${ARAVIS_PREFIX}/bin;$ENV{PATH}")
elseif(CMAKE_HOST_APPLE)
    set(runtime "${ARAVIS_PREFIX}/lib/libaravis-0.8.dylib")
else()
    set(runtime "${ARAVIS_PREFIX}/lib/libaravis-0.8.so")
    set(ENV{LD_LIBRARY_PATH} "${ARAVIS_PREFIX}/lib:$ENV{LD_LIBRARY_PATH}")
endif()
if(NOT EXISTS "${runtime}" OR EXISTS "${ARAVIS_PREFIX}/lib/libaravis-0.8.a")
    message(FATAL_ERROR "Expected shared-only Aravis installation: ${runtime}")
endif()
if(CMAKE_HOST_WIN32)
    set(tool_suffix .exe)
endif()
run("${ARAVIS_PREFIX}/bin/arv-tool-0.8${tool_suffix}" --version)
message(STATUS "Aravis ${version} shared library installed in ${ARAVIS_PREFIX}")
message(STATUS "pkg-config directory: ${ARAVIS_PREFIX}/lib/pkgconfig")