cmake_minimum_required(VERSION 3.21)
foreach(required IN ITEMS BUILD_DIR OUTPUT_DIR)
    if(NOT DEFINED ${required})
        message(FATAL_ERROR "Pass -D${required}=...")
    endif()
endforeach()
get_filename_component(BUILD_DIR "${BUILD_DIR}" ABSOLUTE)
get_filename_component(OUTPUT_DIR "${OUTPUT_DIR}" ABSOLUTE)
set(stage "${BUILD_DIR}/portable")
if(EXISTS "${stage}")
    message(FATAL_ERROR "Package staging directory already exists: ${stage}; use a fresh build directory")
endif()
file(MAKE_DIRECTORY "${OUTPUT_DIR}")
function(run)
    execute_process(COMMAND ${ARGV} COMMAND_ECHO STDOUT COMMAND_ERROR_IS_FATAL ANY)
endfunction()
run("${CMAKE_COMMAND}" --install "${BUILD_DIR}" --config Release --component Runtime --prefix "${stage}/SLStudio")
if(CMAKE_HOST_APPLE)
    set(bundle "${stage}/SLStudio/SLStudio.app")
    if(NOT EXISTS "${bundle}/Contents/MacOS/SLStudio")
        message(FATAL_ERROR "Missing installed macOS app bundle")
    endif()
    set(licenses "${bundle}/Contents/Resources/licenses/homebrew")
    file(MAKE_DIRECTORY "${licenses}")
    execute_process(COMMAND brew info --json=v2 --installed
        OUTPUT_FILE "${licenses}/packages.json" COMMAND_ERROR_IS_FATAL ANY)
    execute_process(COMMAND brew --cellar OUTPUT_VARIABLE cellar
        OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
    file(GLOB notices LIST_DIRECTORIES FALSE
        "${cellar}/*/*/LICENSE*" "${cellar}/*/*/COPYING*" "${cellar}/*/*/NOTICE*"
        "${cellar}/*/*/COPYRIGHT*" "${cellar}/*/*/copyright"
        "${cellar}/*/*/share/doc/*/copyright"
        "${cellar}/*/*/share/doc/*/LICENSE*" "${cellar}/*/*/share/doc/*/COPYING*"
        "${cellar}/*/*/share/doc/*/NOTICE*" "${cellar}/*/*/share/licenses/*/*")
    foreach(notice IN LISTS notices)
        file(RELATIVE_PATH relative "${cellar}" "${notice}")
        get_filename_component(directory "${relative}" DIRECTORY)
        file(COPY "${notice}" DESTINATION "${licenses}/${directory}")
    endforeach()
    # Fixups and resources must be complete before the bundle is signed.
    run(codesign --force --deep --sign - "${bundle}")
    run(codesign --verify --deep --strict "${bundle}")
    run("${CMAKE_COMMAND}" -E create_symlink /Applications "${stage}/SLStudio/Applications")
    execute_process(COMMAND uname -m OUTPUT_VARIABLE architecture OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
    set(output "${OUTPUT_DIR}/SLStudio-macos-${architecture}.dmg")
    run(hdiutil create -volname SLStudio -srcfolder "${stage}/SLStudio" -format UDZO "${output}")
elseif(CMAKE_HOST_WIN32)
    set(output "${OUTPUT_DIR}/SLStudio-windows-x64.zip")
    execute_process(COMMAND "${CMAKE_COMMAND}" -E tar cf "${output}" --format=zip SLStudio
        WORKING_DIRECTORY "${stage}" COMMAND_ERROR_IS_FATAL ANY)
else()
    message(FATAL_ERROR "Use package-appimage.sh on Linux")
endif()
file(SHA256 "${output}" checksum)
get_filename_component(filename "${output}" NAME)
file(WRITE "${output}.sha256" "${checksum}  ${filename}\n")
