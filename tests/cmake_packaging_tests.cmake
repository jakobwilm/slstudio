cmake_minimum_required(VERSION 3.21)
if(NOT DEFINED TEST_BINARY_DIR)
    message(FATAL_ERROR "Pass -DTEST_BINARY_DIR=...")
endif()
get_filename_component(source "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
set(fixture "${TEST_BINARY_DIR}/source")
file(MAKE_DIRECTORY "${fixture}/imgui" "${fixture}/src/projector/LC3000API")
file(COPY "${source}/LICENSE" "${source}/README.md" "${source}/THIRD_PARTY_NOTICES.md"
    DESTINATION "${fixture}")
set(manifest "v2.0 DLP LightCrafter API Sample Code Manifest.htm")
file(COPY "${source}/src/projector/LC3000API/${manifest}"
    DESTINATION "${fixture}/src/projector/LC3000API")
file(WRITE "${fixture}/imgui/LICENSE.txt" "Test ImGui notice\n")
file(MAKE_DIRECTORY "${fixture}/vcpkg/test-triplet/share/test-dependency")
foreach(notice IN ITEMS copyright LICENSE.txt COPYING NOTICE.txt)
    file(WRITE "${fixture}/vcpkg/test-triplet/share/test-dependency/${notice}" "Test ${notice}\n")
endforeach()
file(WRITE "${fixture}/CMakeLists.txt" "
cmake_minimum_required(VERSION 3.21)
project(PackagingNotices NONE)
set(CMAKE_INSTALL_DATADIR share)
set(imgui_SOURCE_DIR \"${fixture}/imgui\")
if(SLSTUDIO_PROJECTOR_LC3000)
    add_library(slstudio_lc3000_protocol INTERFACE)
endif()
include(\"${source}/cmake/SLStudioPackaging.cmake\")
")

foreach(mode IN ITEMS headless desktop macos windows)
    set(build "${TEST_BINARY_DIR}/${mode}")
    set(stage "${build}/stage")
    set(gui OFF)
    set(lc3000 OFF)
    set(apple OFF)
    set(windows OFF)
    set(destination "${stage}/share/licenses/SLStudio")
    if(NOT mode STREQUAL "headless")
        set(gui ON)
        set(lc3000 ON)
    endif()
    if(mode STREQUAL "macos")
        set(apple ON)
        set(destination "${stage}/SLStudio.app/Contents/Resources/licenses")
    elseif(mode STREQUAL "windows")
        set(windows ON)
    endif()
    execute_process(COMMAND "${CMAKE_COMMAND}" -S "${fixture}" -B "${build}"
        "-DSLSTUDIO_BUILD_GUI=${gui}" "-DSLSTUDIO_PROJECTOR_LC3000=${lc3000}"
        "-DAPPLE=${apple}" "-DWIN32=${windows}"
        "-DVCPKG_INSTALLED_DIR=${fixture}/vcpkg" -DVCPKG_TARGET_TRIPLET=test-triplet
        COMMAND_ERROR_IS_FATAL ANY)
    execute_process(COMMAND "${CMAKE_COMMAND}" --install "${build}"
        --prefix "${stage}" --component Runtime
        COMMAND_ERROR_IS_FATAL ANY)
    foreach(document IN ITEMS LICENSE README.md THIRD_PARTY_NOTICES.md)
        file(SHA256 "${source}/${document}" expected)
        file(SHA256 "${destination}/${document}" actual)
        if(NOT actual STREQUAL expected)
            message(FATAL_ERROR "${mode}: ${document} was not installed intact")
        endif()
    endforeach()
    if(gui)
        file(SHA256 "${source}/src/projector/LC3000API/${manifest}" expected)
        file(SHA256 "${destination}/ti-lc3000/${manifest}" actual)
        if(NOT actual STREQUAL expected OR NOT EXISTS "${destination}/imgui/LICENSE.txt")
            message(FATAL_ERROR "${mode}: dependency notices missing or changed")
        endif()
    elseif(EXISTS "${destination}/imgui" OR EXISTS "${destination}/ti-lc3000")
        message(FATAL_ERROR "Headless fixture installed disabled dependency notices")
    endif()
    if(windows)
        foreach(notice IN ITEMS copyright LICENSE.txt COPYING NOTICE.txt)
            file(SHA256 "${fixture}/vcpkg/test-triplet/share/test-dependency/${notice}" expected)
            file(SHA256 "${destination}/vcpkg/test-dependency/${notice}" actual)
            if(NOT actual STREQUAL expected)
                message(FATAL_ERROR "Windows fixture: ${notice} was not installed intact")
            endif()
        endforeach()
    endif()
endforeach()
message(STATUS "Packaging notice install tests passed")
