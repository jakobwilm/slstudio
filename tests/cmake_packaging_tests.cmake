cmake_minimum_required(VERSION 3.21)
if(NOT DEFINED TEST_BINARY_DIR)
    message(FATAL_ERROR "Pass -DTEST_BINARY_DIR=...")
endif()
get_filename_component(source "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
set(fixture "${TEST_BINARY_DIR}/source")
file(MAKE_DIRECTORY "${fixture}/imgui" "${fixture}/src/projector/LC3000API" "${fixture}/cmake")
file(COPY "${source}/cmake/InstallRuntime.cmake.in" DESTINATION "${fixture}/cmake")
file(COPY "${source}/LICENSE" "${source}/README.md" "${source}/THIRD_PARTY_NOTICES.md"
    DESTINATION "${fixture}")
set(manifest "v2.0 DLP LightCrafter API Sample Code Manifest.htm")
file(COPY "${source}/src/projector/LC3000API/${manifest}"
    DESTINATION "${fixture}/src/projector/LC3000API")
file(WRITE "${fixture}/imgui/LICENSE.txt" "Test ImGui notice\n")
file(MAKE_DIRECTORY "${fixture}/vcpkg/test-triplet/share/test-dependency")
foreach(notice IN ITEMS copyright LICENSE.txt COPYING NOTICE.txt)
    file(WRITE "${fixture}/vcpkg/test-triplet/share/test-dependency/${notice}" "Test ${notice}\n")
endforeach()
file(WRITE "${fixture}/CMakeLists.txt" "
cmake_minimum_required(VERSION 3.21)
project(PackagingNotices NONE)
set(APPLE \${TEST_APPLE})
set(WIN32 \${TEST_WIN32})
set(CMAKE_INSTALL_DATADIR share)
set(imgui_SOURCE_DIR \"${fixture}/imgui\")
if(SLSTUDIO_PROJECTOR_LC3000)
    add_library(slstudio_lc3000_protocol INTERFACE)
endif()
include(\"${source}/cmake/SLStudioPackaging.cmake\")
")

foreach(mode IN ITEMS headless desktop macos windows)
    set(build "${TEST_BINARY_DIR}/${mode}")
    set(stage "${build}/stage")
    set(gui OFF)
    set(lc3000 OFF)
    set(apple OFF)
    set(windows OFF)
    set(destination "${stage}/share/licenses/SLStudio")
    if(NOT mode STREQUAL "headless")
        set(gui ON)
        set(lc3000 ON)
    endif()
    if(mode STREQUAL "macos")
        set(apple ON)
        set(destination "${stage}/SLStudio.app/Contents/Resources/licenses")
    elseif(mode STREQUAL "windows")
        set(windows ON)
    endif()
    execute_process(COMMAND "${CMAKE_COMMAND}" -S "${fixture}" -B "${build}"
        "-DSLSTUDIO_BUILD_GUI=${gui}" "-DSLSTUDIO_PROJECTOR_LC3000=${lc3000}"
        "-DTEST_APPLE=${apple}" "-DTEST_WIN32=${windows}"
        "-DVCPKG_INSTALLED_DIR=${fixture}/vcpkg" -DVCPKG_TARGET_TRIPLET=test-triplet
        COMMAND_ERROR_IS_FATAL ANY)
    execute_process(COMMAND "${CMAKE_COMMAND}" --install "${build}"
        --prefix "${stage}" --component Runtime
        COMMAND_ERROR_IS_FATAL ANY)
    foreach(document IN ITEMS LICENSE README.md THIRD_PARTY_NOTICES.md)
        file(SHA256 "${source}/${document}" expected)
        file(SHA256 "${destination}/${document}" actual)
        if(NOT actual STREQUAL expected)
            message(FATAL_ERROR "${mode}: ${document} was not installed intact")
        endif()
    endforeach()
    if(gui)
        file(SHA256 "${source}/src/projector/LC3000API/${manifest}" expected)
        file(SHA256 "${destination}/ti-lc3000/${manifest}" actual)
        if(NOT actual STREQUAL expected OR NOT EXISTS "${destination}/imgui/LICENSE.txt")
            message(FATAL_ERROR "${mode}: dependency notices missing or changed")
        endif()
    elseif(EXISTS "${destination}/imgui" OR EXISTS "${destination}/ti-lc3000")
        message(FATAL_ERROR "Headless fixture installed disabled dependency notices")
    endif()
    if(windows)
        foreach(notice IN ITEMS copyright LICENSE.txt COPYING NOTICE.txt)
            file(SHA256 "${fixture}/vcpkg/test-triplet/share/test-dependency/${notice}" expected)
            file(SHA256 "${destination}/vcpkg/test-dependency/${notice}" actual)
            if(NOT actual STREQUAL expected)
                message(FATAL_ERROR "Windows fixture: ${notice} was not installed intact")
            endif()
        endforeach()
    endif()
endforeach()

set(build "${TEST_BINARY_DIR}/windows-runtime")
set(vcpkg "${fixture}/vcpkg/test-triplet")
execute_process(COMMAND "${CMAKE_COMMAND}" -S "${fixture}" -B "${build}"
    -DTEST_APPLE=OFF -DTEST_WIN32=ON -DSLSTUDIO_BUILD_GUI=OFF
    -DSLSTUDIO_PROJECTOR_LC3000=OFF -DSLSTUDIO_PACKAGE_RUNTIME=ON
    "-DVCPKG_INSTALLED_DIR=${fixture}/vcpkg" -DVCPKG_TARGET_TRIPLET=test-triplet
    "-DCMAKE_PREFIX_PATH=${vcpkg}/debug;${vcpkg}"
    COMMAND_ERROR_IS_FATAL ANY)
file(READ "${build}/InstallRuntime.cmake" runtime_script)
if(runtime_script MATCHES "${vcpkg}/debug/bin" OR
   runtime_script MATCHES "${vcpkg}/debug/lib" OR
   NOT runtime_script MATCHES "${vcpkg}/bin")
    message(FATAL_ERROR "Windows release packaging must search release, not debug, vcpkg runtimes")
endif()
message(STATUS "Packaging notice install tests passed")

if(CMAKE_HOST_SYSTEM_NAME STREQUAL "Linux")
    set(appdir "${TEST_BINARY_DIR}/AppDir with spaces")
    set(data_home "${TEST_BINARY_DIR}/desktop data")
    set(desktop "${data_home}/applications/slstudio.desktop")
    set(image "${TEST_BINARY_DIR}/SLStudio beta 100%.AppImage")
    file(MAKE_DIRECTORY "${appdir}/usr/bin"
        "${appdir}/usr/share/icons/hicolor/256x256/apps" "${appdir}/usr/share/applications")
    file(COPY "${source}/resources/slstudio.png" DESTINATION "${appdir}/usr/share/icons/hicolor/256x256/apps")
    file(COPY "${source}/resources/slstudio.desktop" DESTINATION "${appdir}/usr/share/applications")
    file(WRITE "${appdir}/usr/bin/SLStudio" "#!/bin/sh\nprintf '%s\\n' \"$@\" > '${appdir}/arguments'\n")
    file(CHMOD "${appdir}/usr/bin/SLStudio" PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE)
    file(REMOVE "${desktop}" "${data_home}/SLStudio/slstudio.png")
    function(run_appimage)
        execute_process(COMMAND "${CMAKE_COMMAND}" -E env
            "APPDIR=${appdir}" "APPIMAGE=${image}" "XDG_DATA_HOME=${data_home}"
            RMW_IMPLEMENTATION=rmw_fastrtps_cpp
            sh "${source}/resources/AppRun" ${ARGN}
            COMMAND_ERROR_IS_FATAL ANY)
    endfunction()
    foreach(argument IN ITEMS --help --package-smoke-test --intensity-calibration-smoke-test --projector-smoke-test)
        run_appimage("${argument}")
        if(EXISTS "${desktop}" OR EXISTS "${data_home}/SLStudio/slstudio.png")
            message(FATAL_ERROR "AppImage help/smoke launches must not register a desktop launcher")
        endif()
        file(STRINGS "${appdir}/arguments" actual)
        if(NOT actual STREQUAL argument)
            message(FATAL_ERROR "AppRun did not forward its arguments")
        endif()
    endforeach()
    run_appimage()
    file(READ "${desktop}" launcher)
    if(NOT launcher MATCHES "Name=SLStudio\n" OR
       NOT launcher MATCHES "StartupWMClass=slstudio\n" OR
       NOT launcher MATCHES "X-SLStudio-AppImage=true\n" OR
       NOT launcher MATCHES "SLStudio beta 100%%.AppImage")
        message(FATAL_ERROR "AppImage launcher has incorrect desktop identity or Exec escaping")
    endif()
    file(SHA256 "${source}/resources/slstudio.png" expected)
    file(SHA256 "${data_home}/SLStudio/slstudio.png" actual)
    if(NOT expected STREQUAL actual)
        message(FATAL_ERROR "AppImage did not install its persistent dock icon intact")
    endif()
    set(image "${TEST_BINARY_DIR}/moved SLStudio.AppImage")
    run_appimage()
    file(READ "${desktop}" launcher)
    if(NOT launcher MATCHES "moved SLStudio.AppImage")
        message(FATAL_ERROR "AppImage launcher did not follow a moved image")
    endif()
    file(WRITE "${desktop}" "[Desktop Entry]\nName=Existing launcher\n")
    run_appimage()
    file(READ "${desktop}" launcher)
    if(NOT launcher STREQUAL "[Desktop Entry]\nName=Existing launcher\n")
        message(FATAL_ERROR "AppImage overwrote an unrelated launcher")
    endif()
    message(STATUS "AppImage desktop integration tests passed")
endif()
