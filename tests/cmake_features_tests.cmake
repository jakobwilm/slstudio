cmake_minimum_required(VERSION 3.21)
include("${CMAKE_CURRENT_LIST_DIR}/../cmake/SLStudioFeatures.cmake")

if(DEFINED MODE)
    set(TEST_FEATURE "${MODE}" CACHE BOOL "Existing feature choice")
    slstudio_feature(TEST_FEATURE "Test integration")
    slstudio_resolve_feature(TEST_FEATURE "${AVAILABLE}" "test dependency")
    if(NOT TEST_FEATURE_ENABLED STREQUAL EXPECTED)
        message(FATAL_ERROR "Expected ${EXPECTED}, got ${TEST_FEATURE_ENABLED}")
    endif()
    get_property(type CACHE TEST_FEATURE PROPERTY TYPE)
    if(NOT type STREQUAL "STRING")
        message(FATAL_ERROR "Existing BOOL option was not migrated to STRING")
    endif()
    return()
endif()

slstudio_feature(TEST_DEFAULT "Default integration")
if(NOT TEST_DEFAULT STREQUAL "AUTO")
    message(FATAL_ERROR "Optional integrations must default to AUTO")
endif()

foreach(mode IN ITEMS AUTO ON OFF auto invalid)
    foreach(available IN ITEMS ON OFF)
        set(expected OFF)
        if(available AND NOT mode STREQUAL "OFF")
            set(expected ON)
        endif()
        execute_process(
            COMMAND "${CMAKE_COMMAND}" "-DMODE=${mode}" "-DAVAILABLE=${available}" "-DEXPECTED=${expected}"
                -P "${CMAKE_CURRENT_LIST_FILE}"
            RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
        if(mode STREQUAL "invalid")
            if(result EQUAL 0 OR NOT error MATCHES "must be AUTO, ON or OFF")
                message(FATAL_ERROR "Invalid mode was not rejected: ${output}${error}")
            endif()
        elseif(mode STREQUAL "ON" AND NOT available)
            if(result EQUAL 0 OR NOT error MATCHES "TEST_FEATURE=ON requires test dependency")
                message(FATAL_ERROR "Missing required integration was not rejected: ${output}${error}")
            endif()
        elseif(NOT result EQUAL 0)
            message(FATAL_ERROR "${mode}/${available} failed: ${output}${error}")
        endif()
    endforeach()
endforeach()

# Resolved state must be recomputed without turning an AUTO choice into ON/OFF.
slstudio_resolve_feature(TEST_DEFAULT ON "test dependency")
slstudio_resolve_feature(TEST_DEFAULT OFF "test dependency")
if(NOT TEST_DEFAULT STREQUAL "AUTO" OR TEST_DEFAULT_ENABLED)
    message(FATAL_ERROR "AUTO discovery retained stale state or overwrote the requested mode")
endif()
message(STATUS "CMake feature mode tests passed")
